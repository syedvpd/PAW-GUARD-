# Environment
ENVIRONMENT=local
DEBUG=true

# App
APP_NAME=PawGuard
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database — Backend (used by the running application)
# Replace with your real connection string; never commit live credentials.
DATABASE_URL=postgresql+asyncpg://pawguard:pawguard@localhost:5432/pawguard

# Database — Frontend (migration-synced copy for the frontend team)
# Replace with your real connection string; never commit live credentials.
# DATABASE_URL_FRONTEND=postgresql+asyncpg://pawguard:pawguard@localhost:5432/pawguard
# # Database — Frontend (migration-synced copy for the frontend team)
# DATABASE_URL_FRONTEND=postgresql+asyncpg://postgres.gcrhfbzmisdrqmegmawm:pawguardtest2026@aws-0-ap-southeast-1.pooler.supabase.com:6543/

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256) — generate with:
#   openssl genrsa -out secrets/private_key.pem 2048
#   openssl rsa -in secrets/private_key.pem -pubout -out secrets/public_key.pem
#
# Local dev reads the PEM files below. Hosted environments (Render, etc.) have
# no secrets/ directory, so set the PEM CONTENTS in these env vars instead —
# they take precedence over the paths. Literal \n escapes are accepted.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PATH=./secrets/private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/public_key.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PRE_AUTH_TOKEN_EXPIRE_MINUTES=5

# MFA — TOTP secrets are encrypted at rest with Fernet. When this is unset the
# key is derived from the JWT private key; set an independent key in production
# so rotating the JWT keypair does not orphan stored MFA secrets.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# OAuth / Social login - the audience (client id) of the Google / Apple app
# whose ID tokens this backend accepts. OAuth login FAILS CLOSED when unset:
# a provider token whose aud does not match is rejected (prevents cross-app
# token confusion / account takeover).
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# S3
S3_BUCKET_NAME=pawguard-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mail — Brevo (https://app.brevo.com/settings/keys/smtp)
# Free tier: 300 emails/day. Get SMTP key at Settings -> SMTP & API -> SMTP.
MAIL_FROM=no-reply@pawguard.org
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Prefer the Brevo REST API (port 443) - works on all cloud platforms.
# Get key at Settings -> SMTP & API -> API Keys (starts with xkeysib-).
# When set, MAIL_HOST/PORT/USERNAME/PASSWORD are ignored.
BREVO_API_KEY=

# Frontend URLs (for email links)
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173
# Mobile deep link base for email verification links sent to the mobile app.
# The Flutter app registers the ``pawguard://`` scheme and handles
# ``pawguard://pawguard.com/verify-email?token=<TOKEN>``.
MOBILE_DEEP_LINK_BASE=pawguard://pawguard.com

# Firebase Cloud Messaging (FCM) — push notifications
# Path to the Firebase service account JSON credentials file.
# Download from Firebase Console > Project Settings > Service accounts.
# When unset, push notifications silently degrade to in-app only.
FCM_CREDENTIALS_PATH=

# Payments (provider is swappable via PAYMENT_GATEWAY; add a new adapter under
# core/payments/ to switch, e.g. to stripe)
PAYMENT_GATEWAY=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
