# Build context exclusions: keep the context lean and keep secrets out of it.
# The image only needs pyproject.toml, README.md, src/, scripts/, alembic/,
# alembic.ini, and docker-entrypoint.sh (all COPY'd explicitly in the Dockerfile).

.git
.github
.gitignore
.env
.env.*
!.env.example
secrets/
env_name/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
tests/
docs/
*.md
!README.md
start.bat
*.log
