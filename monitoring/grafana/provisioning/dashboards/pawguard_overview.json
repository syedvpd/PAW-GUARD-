    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "HTTP Error Rates (5xx / 4xx)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": null,
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Internal Errors"
