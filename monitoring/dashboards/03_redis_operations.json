{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Redis Commands Throughput (Ops/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(redis_operations_total[1m])) by (op, namespace)",
          "legendFormat": "{{namespace}}: {{op}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(sum(rate(redis_cache_hits_total[1m])) / (sum(rate(redis_cache_hits_total[1m])) + sum(rate(redis_cache_misses_total[1m])))) * 100",
          "legendFormat": "Hit Ratio %"
        }
      ]
    },
    {
      "title": "Redis Operation Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(redis_operation_duration_ms_bucket[1m])) by (le, op))",
          "legendFormat": "p95 {{op}} (ms)"
        }
      ]
    },
    {
      "title": "Distributed Lock Acquisition & Contention",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(redis_operations_total{op='acquire_lock'}[1m])) by (status)",
          "legendFormat": "Lock Status: {{status}}"
        }
      ]
    },
    {
      "title": "Redis Errors & Degraded Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(redis_operations_total{status=~'error|unavailable'}[1m])) by (op, namespace)",
          "legendFormat": "Failures {{namespace}} {{op}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pawguard", "redis", "cache"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "PawGuard — 03 Redis Operations",
