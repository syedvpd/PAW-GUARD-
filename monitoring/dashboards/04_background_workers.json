  "panels": [
    {
      "title": "ARQ Job Processing Rate (Jobs/sec by Status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(worker_jobs_total[1m])) by (job, status)",
          "legendFormat": "{{job}} [{{status}}]"
        }
      ]
    },
    {
      "title": "Job Execution Duration (p95 ms by Job)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(worker_job_duration_ms_bucket[1m])) by (le, job))",
          "legendFormat": "p95 {{job}} (ms)"
        }
      ]
    },
    {
      "title": "Job Retries Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(worker_job_retries_total[1m])) by (job)",
          "legendFormat": "Retries {{job}}"
        }
      ]
    },
    {
      "title": "Job Terminal Failures Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(worker_job_failures_total[1m])) by (job)",
          "legendFormat": "Failures {{job}}"
        }
      ]
    }
  ],
