      "name": "Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"New User\",\n  \"phone\": \"+1234567890\",\n  \"device\": {\n    \"id\": \"web-browser-001\",\n    \"device_type\": \"web\",\n    \"os\": \"Chrome\",\n    \"model\": \"desktop\",\n    \"manufacturer\": \"Google\",\n    \"push_token\": null\n  }\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/v1/auth/register",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
